{
   "action": {
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "content_scripts": [
      {
         "matches": [
            "*://vod.sooplive.com/player/*",
            "*://vod.sooplive.co.kr/player/*"
         ],
         "js": [
            "prev-chat-bridge.js"
         ],
         "run_at": "document_idle",
         "world": "ISOLATED"
      },
      {
         "matches": [
            "*://vod.sooplive.com/player/*",
            "*://vod.sooplive.co.kr/player/*"
         ],
         "js": [
            "prev-chat.js"
         ],
         "run_at": "document_idle",
         "world": "MAIN"
      }
   ],
   "declarative_net_request": {
      "rule_resources": [
         {
            "id": "ruleset_1",
            "enabled": true,
            "path": "rules.json"
         }
      ]
   },
   "description": "Soop VOD 다운로드 및 영상 합치기 확장프로그램",
   "host_permissions": [
      "*://sooplive.com/*",
      "*://*.sooplive.com/*",
      "*://sooplive.co.kr/*",
      "*://*.sooplive.co.kr/*",
      "https://docs.google.com/*",
      "https://soop.space:2083/*",
      "http://127.0.0.1:18787/*"
   ],
   "icons": {
      "128": "icons/128.png",
      "16": "icons/16.png",
      "48": "icons/48.png"
   },
   "manifest_version": 3,
   "name": "Soop VOD Downloader",
   "permissions": [
      "scripting",
      "activeTab",
      "declarativeNetRequest",
      "clipboardWrite",
      "storage"
   ],
   "version": "3.17.0",
   "web_accessible_resources": [
      {
         "matches": [
            "<all_urls>"
         ],
         "resources": [
            "merge.html",
            "merge.js",
            "styles.css"
         ]
      }
   ]
}
