{
   "action": {
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "declarative_net_request": {
      "rule_resources": [
         {
            "id": "ruleset_1",
            "enabled": true,
            "path": "rules.json"
         }
      ]
   },
   "description": "Soop VOD 다운로드 및 영상 합치기 확장프로그램",
   "host_permissions": [
      "*://*.sooplive.co.kr/*",
      "https://soop.space:2083/*"
   ],
   "icons": {
      "128": "icons/128.png",
      "16": "icons/16.png",
      "48": "icons/48.png"
   },
   "manifest_version": 3,
   "name": "Soop VOD Downloader",
   "permissions": [
      "scripting",
      "activeTab",
      "declarativeNetRequest",
      "clipboardWrite"
   ],
   "version": "3.4.3",
   "web_accessible_resources": [
      {
         "matches": [
            "<all_urls>"
         ],
         "resources": [
            "merge.html",
            "merge.js",
            "style.css"
         ]
      }
   ]
}